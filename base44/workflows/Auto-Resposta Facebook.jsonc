{
  "name": "Auto-Resposta Facebook Off-Hours",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/30 * * * *",
      "one_time_date": null,
      "timezone": "America/Sao_Paulo",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "fb_auto_reply",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "reply": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "facebookAutoReply",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Responder mensagens do Facebook",
            "description": "Auto-reply fora do hor\u00e1rio comercial"
          }
        }
      }
    ]
  },
  "description": "A cada 30 min, l\u00ea mensagens n\u00e3o lidas da p\u00e1gina do Facebook e responde automaticamente (apenas fora do hor\u00e1rio comercial). Respeita limites di\u00e1rios, or\u00e7amento mensal e dedup de respostas."
}